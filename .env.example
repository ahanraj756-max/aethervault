# General Application Config
APP_NAME=AetherVault
ENVIRONMENT=development

# Database Setup (SQLite for local, PostgreSQL compatible)
DATABASE_URL=sqlite:///./app.db

# JWT Secret Key - Change this in production!
SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_1234567890

# Storage Directories
# Relative to run.py/workspace root, or absolute path
STORAGE_ROOT=./storage
MAX_UPLOAD_SIZE_MB=500
DEFAULT_STORAGE_QUOTA_GB=1024

# AI Services Configuration
# Set AI_ENABLED=true to run local extraction/smart search.
AI_ENABLED=false
# AI_PROVIDER can be 'local' (offline metadata & regex search) or 'gemini' (needs GEMINI_API_KEY)
AI_PROVIDER=local
GEMINI_API_KEY=
